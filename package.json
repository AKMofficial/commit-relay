{
  "name": "commit-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted webhook receiver that posts one Basecamp Campfire chat line per GitHub commit. Not affiliated with, endorsed by, or sponsored by 37signals, LLC. Basecamp\u00ae and Campfire\u00ae are trademarks of 37signals, LLC. This project is an independent, unofficial integration.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AKMofficial/commit-relay"
  },
  "homepage": "https://github.com/AKMofficial/commit-relay#readme",
  "bugs": {
    "url": "https://github.com/AKMofficial/commit-relay/issues"
  },
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.workers.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "typecheck:build": "tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:workers": "vitest run --project=workers",
    "test:node": "vitest run --project=node",
    "build:workers": "wrangler deploy --dry-run --outdir=.wrangler/dry",
    "build:node": "tsc -p tsconfig.node.json",
    "types": "wrangler types --include-runtime worker-configuration.d.ts",
    "dev:workers": "wrangler dev",
    "dev:node": "node --env-file=.env --watch src/server.ts",
    "send:fixture": "node scripts/send-fixture.ts",
    "screenshot": "node scripts/render-screenshot.ts"
  },
  "dependencies": {
    "hono": "^4",
    "zod": "^4"
  },
  "optionalDependencies": {
    "@hono/node-server": "^2.1.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.0",
    "@types/node": "^24",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "wrangler": "^4"
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499"
}
