# commit-relay: Node / Docker / Railway environment.
# Copy to .env and edit. Every variable the schema knows about is listed here.
# Values shown after "default:" are what you get when the variable is unset.
#
# Nothing in this file is a working credential. The webhook secret and the
# chatbot key in the URL below are both on the boot denylist and will be
# refused, deliberately: nobody should be able to copy this file into
# production and have it start.

# ─── Basecamp ────────────────────────────────────────────────────────────────
# Required: either BASECAMP_LINES_URL alone, or the four discrete values.
# The URL form is preferred: three of the four ids are indistinguishable
# 7-digit numbers and swapping two of them 404s in a way that reads as
# "wrong project". Set it and leave the four below empty.
# Secret. Default: none.
BASECAMP_LINES_URL=https://3.basecampapi.com/1234567/integrations/PLACEHOLDERKEY0123456789/buckets/2345678/chats/7654321/lines.json

# The four below are the other form. Left empty on purpose: BASECAMP_LINES_URL
# above wins over them, so filling both in silently discards whatever you typed
# here. Use these only if you clear BASECAMP_LINES_URL first.
# The number immediately after the host in any Basecamp URL. Default: none.
BASECAMP_ACCOUNT_ID=
# Secret. The token between /integrations/ and /buckets/. Default: none.
# A bearer credential in a URL path: never log it, never commit it. Rotate by
# deleting the chatbot and creating a new one.
BASECAMP_CHATBOT_KEY=
# The number after /buckets/ (a bucket is a project). Default: none.
BASECAMP_BUCKET_ID=
# The number after /chats/ (the Campfire). Default: none.
BASECAMP_CHAT_ID=

# Optional. Override for tests and mocks. Default: https://3.basecampapi.com
BASECAMP_API_BASE=https://3.basecampapi.com
# Optional. Per-POST timeout in ms. Default: 10000
BASECAMP_TIMEOUT_MS=10000
# Optional. Floor between posts in ms; 250 is 4 req/s. Default: 250
BASECAMP_MIN_INTERVAL_MS=250
# Optional. Clamp on any Retry-After / x-ratelimit sleep in ms. Default: 30000
BASECAMP_MAX_SLEEP_MS=30000
# Optional. Sent to Basecamp and GitHub; both require one. Put a real contact
# address in it. Default: derived from package.json (name, version, repository).
USER_AGENT=commit-relay (you@example.com)

# ─── GitHub ──────────────────────────────────────────────────────────────────
# REQUIRED. The "Secret" field on the GitHub webhook. Minimum 32 characters.
# Generate one with: openssl rand -hex 32
# The placeholder below is published in this repository and boot refuses it.
GITHUB_WEBHOOK_SECRET=replace-me-with-openssl-rand-hex-32

# Secret. Fine-grained PAT with Contents: read. Optional, but mandatory in
# practice for private repos: unauthenticated requests get 404, not 403.
# Additional tokens for other orgs are GITHUB_TOKEN_<SUFFIX>, referenced from a
# route's githubTokenEnv. Default: none.
GITHUB_TOKEN=

# Optional. GitHub Enterprise Server API base. Default: https://api.github.com
GITHUB_API_BASE=https://api.github.com
# Optional. The WEB origin, not the API one. It is the sole allowlist every
# rendered href is checked against. Default: https://github.com
GITHUB_WEB_ORIGIN=https://github.com
# Optional. Parallel stats lookups in the enricher window. Default: 4
GITHUB_CONCURRENCY=4
# Optional. Per stats request, in ms. Default: 8000
GITHUB_TIMEOUT_MS=8000
# Optional. Byte budget on a stats response before the read is aborted and the
# commit resolves to stats: null. Default: 1048576
GITHUB_STATS_MAX_BYTES=1048576
# Optional. auto (on iff a token resolves) / on / off. Default: auto
FETCH_LINE_STATS=auto
# Optional. Boot fails if FETCH_LINE_STATS would resolve to off. Set it when
# every relayed repo is private and a blank Changes row is unacceptable.
# Default: false
REQUIRE_LINE_STATS=false

# ─── Routing ─────────────────────────────────────────────────────────────────
# Optional. The routing document (see config.example.json) as one JSON line.
# Beats CONFIG_FILE. Only needed for multi-repo / multi-room. Default: none.
ROUTES=
# Optional. Node only. Path to the same JSON as a file. There is no implicit
# ./config.json. Default: none.
CONFIG_FILE=

# Optional. Global branch allowlist, comma-separated globs, case-sensitive.
# ** means every branch, which is the default. Narrow it to quieten a busy repo.
BRANCHES=**
# Optional. Tag allowlist, matched with refs/tags/ stripped. EMPTY MEANS NO TAG
# PUSH IS EVER RELAYED. Default: empty
TAGS=
# Optional. Which pull request actions post a message, comma-separated.
# Empty relays no pull request at all. Default: opened,closed,reopened,ready_for_review
PR_ACTIONS=opened,closed,reopened,ready_for_review
# Optional. Post a message when a review is submitted (approved or changes
# requested). Default: true
PR_REVIEWS=true
# Optional. Suppress a draft pull request until it is marked ready for review.
# Default: true
PR_SKIP_DRAFTS=true

# Optional. owner/repo globs, evaluated before routing, case-insensitive.
# Empty accepts any correctly-signed repo and warns once at boot. Default: empty
REPO_ALLOWLIST=

# ─── Filtering ───────────────────────────────────────────────────────────────
# Optional. true posts nothing at all for a forced push. Left false, a forced
# push posts one rollup labelled as a force push. Default: false
SKIP_FORCED_PUSHES=false
# Optional. Suppresses the merge commit itself; the branch commits still post.
# Default: true
SKIP_MERGE_COMMITS=true
# Optional. Drops commits delivered with distinct: false. Default: true
SKIP_NON_DISTINCT=true
# Optional. Globs matched against sender.login, commit.author.username and
# commit.author.email. Suggestion: dependabot[bot],renovate[bot]
# Default: empty
IGNORE_AUTHORS=

# ─── Limits ──────────────────────────────────────────────────────────────────
# Optional. Per-push cap on individually rendered commits; above it, one rollup.
# Set by Cloudflare's free-plan 50-subrequest ceiling, not by taste. Default: 15
MAX_COMMITS_PER_PUSH=15
# Optional. Workers only: outbound calls allowed per invocation (50 on Workers Free).
# Ignored on Node. 0 disables. Default: 50
SUBREQUEST_BUDGET=50
# Optional. Commit message clip in Unicode code points. Default: 2000
COMMIT_BODY_MAX_CHARS=2000
# Optional. Ceiling on the assembled content string in UTF-8 bytes. Default: 16384
CONTENT_MAX_BYTES=16384
# Optional. After this a pending enrichment is force-promoted with stats: null.
# Must be at least GITHUB_TIMEOUT_MS * 3 + 8000. Default: 45000
ENRICH_DEADLINE_MS=45000
# Optional. Total 5xx retry wall-time per message, in ms. Default: 20000
POST_RETRY_BUDGET_MS=20000
# Optional. Separate budget that 429 sleeps draw on, in ms. Default: 60000
RATELIMIT_WAIT_BUDGET_MS=60000
# Optional. Node only. Push jobs held in the in-process FIFO. Default: 500
MAX_QUEUE_DEPTH=500
# Optional. Node only. The same bound counted in bytes. Default: 33554432
MAX_QUEUE_BYTES=33554432
# Optional. Bound on the delivery-id dedup LRU. Default: 10000
DEDUP_MAX_ENTRIES=10000
# Optional. How long a delivery id is remembered; GitHub's manual redelivery
# window is 3 days. Default: 72
DEDUP_TTL_HOURS=72
# Optional. Rolling window over which dropped jobs are counted, in ms.
# Default: 300000
DROP_ALERT_WINDOW_MS=300000
# Optional. Request body ceiling in bytes, just above GitHub's 25 MB payload
# cap. Default: 26214400
MAX_BODY_BYTES=26214400
# Optional. Per-IP cap on the webhook path, applied before HMAC. Default: 120
RATE_LIMIT_PER_MINUTE=120

# ─── Server ──────────────────────────────────────────────────────────────────
# Optional. Node only. X-Forwarded-For entries to skip FROM THE RIGHT. 0 means
# use the socket address and ignore the header. 0 for docker/VPS, 1 for
# Railway/Fly/Render, 2 with a CDN in front. The wrong value turns the rate
# limiter into a no-op. Default: 0
TRUSTED_PROXY_HOPS=0
# Optional. Receiver path. Default: /webhook
WEBHOOK_PATH=/webhook
# Optional. Node only; injected by most PaaS platforms. Default: 3000
PORT=3000
# Optional. Node only. SIGTERM drain budget in ms. Must be below the platform's
# own grace period (Railway defaults to 0; raise drainingSeconds). Default: 20000
SHUTDOWN_DRAIN_MS=20000

# ─── Observability ───────────────────────────────────────────────────────────
# Optional. trace / debug / info / warn / error. Default: info
LOG_LEVEL=info
# Optional. Requires LOG_LEVEL=trace as well. Logs private-repo commit messages
# and file paths. Default: false
LOG_PAYLOADS=false
# Secret. Optional. Compared against the X-Health-Token header; without it
# /health/detail 404s. Generate with: openssl rand -hex 16. Default: none
HEALTH_TOKEN=
