# commit-relay: the secrets the Deploy to Cloudflare button asks for.
#
# The button shows every line of this file as a required field, so it lists only
# the three values a deployment needs. Every other setting has a default and lives
# in wrangler.jsonc "vars" (https://developers.cloudflare.com/workers/platform/deploy-buttons/).
#
# Copied to .dev.vars it is also the local secret store for `wrangler dev`; see
# CONTRIBUTING.md for running it against the mock Basecamp server.
#
# Every value here is fake. The webhook secret is on the boot denylist and will be refused.

# Required. The chatbot's posting URL from the Campfire room: ••• → Configure chatbots.
BASECAMP_LINES_URL=https://3.basecampapi.com/1234567/integrations/PLACEHOLDERKEY0123456789/buckets/2345678/chats/7654321/lines.json

# Required. Generate it with: openssl rand -hex 32. Every GitHub webhook uses this value.
GITHUB_WEBHOOK_SECRET=replace-me-with-openssl-rand-hex-32

# For private repos: a fine-grained token with Contents: Read-only.
# If every relayed repo is public, enter a single space.
GITHUB_TOKEN=
