{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    "lib": ["ES2023"],
    "noEmit": true
  },
  "include": ["src/worker.ts", "src/**/*.ts", "worker-configuration.d.ts"],
  // *.test.ts is excluded because `vitest`'s own type declarations pull
  // @types/node into the program, which would make a stray `node:*` import in
  // src/core resolve here and silently disarm the purity canary of 4.5.
  // src/config/file.ts is Node-only: Workers has no filesystem, and ROUTES
  // carries the same JSON there.
  "exclude": [
    "src/server.ts",
    "src/config/file.ts",
    "src/queue/adapters/memory-fifo.ts",
    "src/**/*.test.ts"
  ]
}
